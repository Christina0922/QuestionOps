# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/questionops?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Dev auth bypass (set to true only for local development without Clerk)
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
DEV_USER_ID=dev_user_1
DEV_ORG_ID=dev_org_1
DEV_USER_EMAIL=dev@questionops.local
DEV_USER_NAME=Dev User
DEV_ORG_NAME=QuestionOps Demo

# OpenAI (Phase 10 - optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
APP_URL="http://localhost:3000"

# YouTube / Google OAuth (operator-managed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/youtube/callback"
YOUTUBE_API_KEY=
# 32-byte key, base64-encoded (e.g. openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
YOUTUBE_MOCK_OAUTH=false

# Job queue (Inngest) — used from Phase Y3
JOB_QUEUE_SECRET=
REDIS_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
